{
	"info": {
		"_postman_id": "trafficvision-api-multi-condition-tests",
		"name": "TrafficVision AI — Multi-Area & Multi-Condition API Test Suite",
		"description": "Postman/Newman collection testing multi-condition traffic scenarios (low, moderate, high, severe) across multiple monitored areas and routes in TrafficVision AI.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000/api",
			"type": "string"
		},
		{
			"key": "highCongestionLocId",
			"value": "11111111-1111-1111-1111-111111111111",
			"type": "string"
		},
		{
			"key": "moderateCongestionLocId",
			"value": "22222222-2222-2222-2222-222222222222",
			"type": "string"
		},
		{
			"key": "lowCongestionLocId",
			"value": "33333333-3333-3333-3333-333333333333",
			"type": "string"
		},
		{
			"key": "expressRouteId",
			"value": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
			"type": "string"
		},
		{
			"key": "testRouteId",
			"value": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Route Analysis & Congestion Level — City Express Corridor",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/routes/{{expressRouteId}}/analysis",
					"host": ["{{baseUrl}}"],
					"path": ["routes", "{{expressRouteId}}", "analysis"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Response contains valid route analysis metrics', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('routeId');",
							"    pm.expect(jsonData).to.have.property('congestionScore');",
							"    pm.expect(jsonData).to.have.property('level');",
							"    pm.expect(['low', 'moderate', 'high', 'severe']).to.include(jsonData.level);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Route Analysis — Test Corridor Multi-Segment",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/routes/{{testRouteId}}/analysis",
					"host": ["{{baseUrl}}"],
					"path": ["routes", "{{testRouteId}}", "analysis"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Returns congestion score between 1.0 and 3.0', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.congestionScore).to.be.at.least(1.0);",
							"    pm.expect(jsonData.congestionScore).to.be.at.most(3.0);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Route Travel Time Computation",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/routes/{{testRouteId}}/travel-time",
					"host": ["{{baseUrl}}"],
					"path": ["routes", "{{testRouteId}}", "travel-time"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Travel time output includes distance, total minutes, and segments', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('totalDistanceKm');",
							"    pm.expect(jsonData).to.have.property('estimatedTravelTimeMinutes');",
							"    pm.expect(jsonData.segments).to.be.an('array');",
							"    pm.expect(jsonData.segments.length).to.be.at.least(1);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Trigger Prediction — High/Severe Congestion Location",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/predictions/{{highCongestionLocId}}",
					"host": ["{{baseUrl}}"],
					"path": ["predictions", "{{highCongestionLocId}}"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201 Created', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test('Prediction generated with high/severe congestion level', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('prediction');",
							"    pm.expect(jsonData.prediction).to.have.property('predicted_congestion');",
							"    pm.expect(['high', 'severe', 'moderate', 'low']).to.include(jsonData.prediction.predicted_congestion);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Trigger Prediction — Low Congestion Location",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/predictions/{{lowCongestionLocId}}",
					"host": ["{{baseUrl}}"],
					"path": ["predictions", "{{lowCongestionLocId}}"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201 Created', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test('Prediction returns rule-based model result', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.prediction.model_version).to.equal('rule-based-v1');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Get Latest Prediction for Location",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/predictions/{{highCongestionLocId}}",
					"host": ["{{baseUrl}}"],
					"path": ["predictions", "{{highCongestionLocId}}"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Returns single prediction record with timestamp', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('prediction_id');",
							"    pm.expect(jsonData).to.have.property('predicted_for');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Get All Disruptions / Alerts",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/alerts",
					"host": ["{{baseUrl}}"],
					"path": ["alerts"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Alerts array returned with valid severity values', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"    if (jsonData.length > 0) {",
							"        pm.expect(jsonData[0]).to.have.property('severity');",
							"        pm.expect(['info', 'warning', 'critical']).to.include(jsonData[0].severity);",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Get Analytics Dashboard Summary",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/analytics/dashboard-summary",
					"host": ["{{baseUrl}}"],
					"path": ["analytics", "dashboard-summary"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Dashboard summary contains total locations and network avg speed', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('total_locations');",
							"    pm.expect(jsonData).to.have.property('active_alerts_count');",
							"    pm.expect(jsonData).to.have.property('network_avg_speed_kmph');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Get Busiest Locations Analytics",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/analytics/busiest-locations?limit=5",
					"host": ["{{baseUrl}}"],
					"path": ["analytics", "busiest-locations"],
					"query": [
						{
							"key": "limit",
							"value": "5"
						}
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Returns max 5 locations sorted by congestion', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"    pm.expect(jsonData.length).to.be.at.most(5);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Get Alert Statistics",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/analytics/alert-stats",
					"host": ["{{baseUrl}}"],
					"path": ["analytics", "alert-stats"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Alert stats contains by_severity object', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('by_severity');",
							"    pm.expect(jsonData).to.have.property('total_alerts');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		}
	]
}
